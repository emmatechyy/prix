# PRIX needs NO secrets to run. Every source below is public and read without a key.
# All variables are optional and server-side only (never exposed to the browser).

# Raises NearBlocks API rate limits (whale tracing, launch creators, Intents events, network history).
# Get one at https://nearblocks.io/apis — sent as "Authorization: Bearer <key>".
NEARBLOCKS_API_KEY=

# Override upstream endpoints (defaults shown).
# NEAR_RPC_URL=https://free.rpc.fastnear.com
# RHEA_INDEXER_URL=https://api.rhea.finance
# RHEA_DATA_SERVICE_URL=https://api.data-service.ref.finance/api
# RHEA_SMART_ROUTER_URL=https://smartrouter.rhea.finance
# NEARBLOCKS_API_URL=https://api.nearblocks.io
# FASTNEAR_API_URL=https://api.fastnear.com
# ONECLICK_API_URL=https://1click.chaindefuser.com
